  "phase3_global_decisions": {
    "feature_drops_from_phase3": [],
    "reason_no_new_drops": "No candidate exceeded a defensible hard-failure threshold. Missingness and structural semantics can be handled without row deletion; predictive value must be tested later using training-only CV/ablation.",
    "target_policy": "_MICHD in {1,2} only. Encode 1->1, 2->0 in Phase 4; target missing is excluded, never imputed.",
    "global_missing_policy": "No global replacement such as {7,9,77,99,88}->NaN. Apply column-specific rules only.",
    "cholesterol_policy": "Keep CHOLCHK3 + TOLDHI3 as primary representation. Force TOLDHI3 to structural missing whenever CHOLCHK3 in {1,7,9} or missing; _RFCHOL3 remains alternative.",
    "bmi_policy": "_BMI5 primary, divide raw stored value by 100. _BMI5CAT alternative. Never use both by default.",
    "age_policy": "_AGEG5YR primary. _AGE80 alternative; it is CDC-imputed and capped at 80.",
    "income_policy": "_INCOMG1 retained despite 21.52% unknown/missing. Do not listwise-delete those rows; handle missingness in pipeline and ablate feature later.",
    "status_proxy_policy": "GENHLTH/PHYSHLTH/MENTHLTH remain primary because project framing is cross-sectional status classification, but they are contemporaneous health-status proxies and require interpretation/ablation caution. CVDSTRK3/ASTHMA3/ADDEPEV3/HAVARTH5/DIFFWALK remain sensitivity features."
